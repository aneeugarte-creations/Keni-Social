      "required": [
        "publicacion"
      ]
    },
    "Run": {
      "type": "object",
      "title": "Run",
      "properties": {
        "id": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "modo": {
          "type": "string"
        },
        "estado": {
          "type": "string"
        },
        "motivo": {
          "type": "string"
        },
        "fecha_inicio": {
          "type": "string"
        },
        "metricas": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricasRun"
            },
            {
              "type": "null"
            }
          ]
        },
        "salida": {
          "type": "string"
        },
        "fecha_fin": {
          "type": "string"
        },
        "agente": {
          "type": "string"
        },
        "agente_nombre": {
          "type": "string"
        }
      },
      "description": "Un run (ejecucion) de un agente, en su forma publica.\n\nForma CANONICA: la de `agentes._parsear_run` (`GET .../runs/{id}` y el listado\n`GET .../runs`): `id/prompt/modo/estado/motivo/fecha_inicio/metricas` + la\n`salida` y `fecha_fin` del run completo. El LISTADO GLOBAL (`GET /api/runs`) y\nel detalle del agente omiten `salida`/`fecha_fin` y, el global, AÑADE\n`agente`/`agente_nombre`: por eso esos cuatro van como `NotRequired`. `metricas`\nes `null` si el run no produjo metricas.",
      "required": [
        "id",
        "prompt",
        "modo",
        "estado",
        "motivo",
        "fecha_inicio",
        "metricas"
      ]
    },
    "RespuestaRun": {
      "type": "object",
      "title": "RespuestaRun",
      "properties": {
        "run": {
          "$ref": "#/$defs/Run"
        },
        "mensaje": {
          "type": "string"
        }
      },
      "description": "Respuesta de los endpoints que devuelven UN run (`{run}`).\n\n`mensaje` solo lo añade el lanzamiento INTERACTIVO (`POST .../runs` con modo\n`interactivo`): el texto legible del lanzamiento; ausente en el resto.",
      "required": [
        "run"
      ]
    },
    "RespuestaRuns": {
      "type": "object",
      "title": "RespuestaRuns",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Run"
          }
        },
        "paginacion": {
          "$ref": "#/$defs/Paginacion"
        }
      },
      "description": "Listado de runs. El global (`GET /api/runs`) trae `paginacion`; el del agente\n(`GET /api/agentes/{id}/runs`) no, por eso es `NotRequired`.",
      "required": [
        "runs"
      ]
    },
