      "required": [
        "marca_id",
        "marca",
        "engagement_pct",
        "pieza",
        "texto"
      ]
    },
    "AnalisisDiario": {
      "type": "object",
      "title": "AnalisisDiario",
      "properties": {
        "rango": {
          "type": "string"
        },
        "etiqueta_rango": {
          "type": "string"
        },
        "marca": {
          "type": "string"
        },
        "fuente": {
          "type": "string"
        },
        "es_muestra": {
          "type": "boolean"
        },
        "movimientos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MovimientoAnalisis"
          }
        },
        "movimientos_resto": {
          "type": "integer"
        },
        "marcas_estables": {
          "type": "integer"
        },
        "cobertura_parcial": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
