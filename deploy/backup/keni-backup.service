[Unit]
Description=keni-social backup local (Postgres dump + snapshot media Garage)
After=docker.service
Requires=docker.service
# Si el backup FALLA, dispara una notificacion (journal err + webhook opcional) via
# keni-alertas (ver deploy/host/). %n = nombre de esta unidad. Si keni-alertas no esta
# instalado, systemd solo loguea un warning y el backup sigue funcionando igual.
OnFailure=keni-alerta-fallo@%n.service

[Service]
Type=oneshot
# Overrides opcionales (BACKUP_DIR, BACKUP_KEEP, BACKUP_RCLONE_REMOTE). El `-` hace que
# falte el fichero sin error.
EnvironmentFile=-/etc/keni-backup.conf
ExecStart=/usr/local/bin/keni-backup
