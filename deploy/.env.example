# Configuracion del stack hosted/equipo de keni-social (deploy/docker-compose.yml).
# Copia a `deploy/.env` y rellena. NUNCA commitees el .env real.
# Genera secretos con:  openssl rand -base64 24   (o -hex 32 donde se indique)

# ---- Dominio + TLS (Traefik / Let's Encrypt) ----
KENI_HOST=social.kenitech.io
KENI_ACME_EMAIL=owner@kenitech.io

# ---- Gateway (back) ----
# Token interino OPCIONAL (#134 -> #130). La barrera PRINCIPAL es ya el login multiusuario
# (sesion) + CSRF: el back queda protegido aunque dejes esto VACIO. Si pones uno fuerte,
# sigue valiendo como gate EXTRA (cabecera/cookie) para clientes de mantenimiento.
KENI_CONSOLA_TOKEN=
# Admin inicial (#130): se crea en el PRIMER arranque si la BD no tiene usuarios.
KENI_CONSOLA_ADMIN_USER=admin
KENI_CONSOLA_ADMIN_PASS=
# Duracion de sesion (horas) y concurrencia de jobs in-process.
KENI_CONSOLA_SESION_HORAS=12
KENI_MAX_JOBS=4

# ---- Credencial de Claude para la generacion `claude -p` (la usa el WORKER) ----
# #130 Fase 2: el back ENCOLA y el servicio `worker` corre `claude -p`; por eso esta
# credencial la consume el WORKER, no el back. NO es la API de Claude: es `claude -p`.
# Usa UNA de las dos (OAuth recomendado en el servidor; claude setup-token).
ANTHROPIC_API_KEY=
# Alternativa: token OAuth de Claude Code (claude setup-token).
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Postgres (db) ----
# CONSUMIDO por el back (#130): con POSTGRES_USER/PASSWORD/DB puestas, la DB operacional
# (tareas/comercial/rota/usuarios/sesiones) va a Postgres. Sin ellas (perfil local) el back
# usa SQLite. El cutover de datos existentes es one-shot:
#   python -m keni_consola.migracion   (ver deploy/README.md "Cutover a Postgres + S3").
POSTGRES_USER=keni
POSTGRES_PASSWORD=
POSTGRES_DB=keni_social
# MINIMO PRIVILEGIO: la app NO conecta como el superuser bootstrap `keni`, sino como un rol
# `keni_app` (sin superusuario). `APP_DB_PASSWORD` es su password; el init script
# `postgres/initdb/10-app-role.sh` lo crea en el PRIMER arranque del cluster (volumen vacio).
# Para activarlo: pon una password aqui Y fija DATABASE_URL a keni_app (abajo).
APP_DB_PASSWORD=
# DATABASE_URL es OPCIONAL. Por defecto EN BLANCO -> el back la DERIVA de POSTGRES_* (conecta
# como el superuser `keni`; util en local/SQLite o bootstrap). EN PRODUCCION fijala al rol de
# minimo privilegio para que el back conecte como keni_app:
#   DATABASE_URL=postgresql://keni_app:${APP_DB_PASSWORD}@db:5432/keni_social
# (si se fija, tiene prioridad sobre POSTGRES_*). Tambien para un Postgres externo / DSN con
# parametros especiales.
DATABASE_URL=

# ---- Garage (files / object storage S3) ----
# CONSUMIDO por el back (#130): con S3_ENDPOINT + S3_ACCESS_KEY + S3_SECRET_KEY puestas,
# la media (imagenes) se guarda y se sirve desde el bucket S3/Garage. Sin ellas (perfil
# local) la media va a disco. Las credenciales se generan en el bootstrap de Garage (README).
GARAGE_RPC_SECRET=        # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=       # openssl rand -base64 24
S3_ENDPOINT=http://files:3900
S3_REGION=garage
S3_BUCKET=keni-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- MCP de metricas ----
# `muestra` = datos offline deterministas (sin credenciales). `real` exige un
# config.toml montado (KENI_METRICAS_CONFIG) con el System User token de Meta.
KENI_METRICAS_FUENTE=muestra
# KENI_METRICAS_CONFIG=/config/config.toml

# ---- Agencias de noticias (item F): Reuters Connect / AFP ----
# CONSUMIDAS por el back: con credencial, la agencia entra al pipeline de fuentes/radar y
# trae notas normalizadas (titulo/resumen/enlace/fecha/fuente) como un feed mas. SIN
# credencial NO rompe nada: la fuente aparece como "pendiente / no configurada" (el Radar y
# la pagina Fuentes lo dicen en claro, sin inventar contenido). Dejalas en BLANCO hasta tener
# la cuenta.
#   Reuters Connect: una API key (Bearer). Opcional KENI_REUTERS_BASE_URL para apuntar a un
#   endpoint/version concreto (def el publico de Reuters Connect).
KENI_REUTERS_API_KEY=
# KENI_REUTERS_BASE_URL=https://api.reutersconnect.com
#   AFP: OAuth2 client_credentials (client_id + client_secret). Opcional KENI_AFP_BASE_URL.
KENI_AFP_CLIENT_ID=
KENI_AFP_CLIENT_SECRET=
# KENI_AFP_BASE_URL=https://afp-apicore-prod.afp.com
