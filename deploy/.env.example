# Configuracion del stack hosted/equipo de keni-social (deploy/docker-compose.yml).
# Copia a `deploy/.env` y rellena. NUNCA commitees el .env real.
# Genera secretos con:  openssl rand -base64 24   (o -hex 32 donde se indique)
#
# SECRETOS COMO FICHERO: en cada `deploy.sh` estas claves se RENDERIZAN del .env a ficheros
# ./secrets/<nombre> (0600) y se montan en /run/secrets/<nombre>; el codigo las lee via las
# env `*_FILE`, asi NO viajan como env del contenedor (no salen en `docker inspect`). Claves
# afectadas: POSTGRES_PASSWORD, S3_ACCESS_KEY, S3_SECRET_KEY, ANTHROPIC_API_KEY,
# KENI_CONSOLA_ADMIN_PASS, KENI_CONSOLA_TOKEN, KENI_MCP_BEARER.
# Tu sigues editando ESTE .env normalmente; el render es automatico.

# ---- Dominio + TLS (Traefik / Let's Encrypt) ----
KENI_HOST=social.kenitech.io
KENI_ACME_EMAIL=owner@kenitech.io

# ---- Gateway (back) ----
# Token interino OPCIONAL (#134 -> #130). La barrera PRINCIPAL es ya el login multiusuario
# (sesion) + CSRF: el back queda protegido aunque dejes esto VACIO. Si pones uno fuerte,
# sigue valiendo como gate EXTRA (cabecera/cookie) para clientes de mantenimiento.
KENI_CONSOLA_TOKEN=
# Bearer del MCP operativo (`/mcp` del back). VACIO => el endpoint /mcp NO se monta (apagado).
KENI_MCP_BEARER=
# La gestion de la cuenta de Claude (panel admin -> Sistema) esta ACTIVA por defecto: no
# requiere configuracion (el bearer interno back<->daemons se auto-persiste en /data).
# Admin inicial (#130): se crea en el PRIMER arranque si la BD no tiene usuarios.
KENI_CONSOLA_ADMIN_USER=admin
KENI_CONSOLA_ADMIN_PASS=
# Duracion de sesion (horas) y concurrencia de jobs `claude -p`.
KENI_CONSOLA_SESION_HORAS=12
# Jobs `claude -p` EN PARALELO: el worker corre un POOL de KENI_MAX_JOBS hilos (cada uno
# reclama+procesa un job). Subirlo => mas paralelismo, pero sube WORKER_MEM_LIMIT/CPUS
# en proporcion (~3 GiB y ~1–1.5 nucleos por job). Def 6 (los jobs son mayormente espera
# de API; el worker tiene 6 cpus / 20 GiB por defecto).
KENI_MAX_JOBS=6
# ---- MFA PASSKEYS / WebAuthn (OPCIONAL, OFF por defecto) ----
# Con KENI_CONSOLA_MFA vacio/0 el login es identico a hoy (sin segundo factor). Para activarlo:
# pon KENI_CONSOLA_MFA=1 Y genera una clave Fernet (firma+fecha la cookie del CHALLENGE/pre-auth
# de la ceremonia WebAuthn; OBLIGATORIA si MFA=1; sin ella las ceremonias devuelven 503
# -fail-safe-, nunca se media-autentica). En passkeys el "secreto" (clave privada) vive en el
# dispositivo del usuario: el servidor solo guarda la clave PUBLICA. Genera la clave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PERDER/ROTAR esta clave solo invalida ceremonias en curso (no las passkeys ya registradas).
# Debe estar en el contenedor `back`.
KENI_CONSOLA_MFA=0
KENI_CONSOLA_MFA_KEY=
# MFA OBLIGATORIO PARA ADMINS (ON por defecto). A diferencia del flag global de arriba, los
# admins quedan sujetos al segundo factor SIEMPRE que haya KENI_CONSOLA_MFA_KEY, aunque
# KENI_CONSOLA_MFA=0: un admin publica en canales de marca y un password robado sin segundo
# factor es account-takeover. Con passkey, el login la EXIGE; sin passkey aun, el admin entra
# pero queda marcado para INSCRIBIR una llave cuanto antes (flujo de gracia, SIN bloqueo).
# RED ANTI-LOCKOUT: sin KENI_CONSOLA_MFA_KEY NO se fuerza nada (el admin entra como hoy). Para
# desactivar el forzado (valvula de escape operativa) pon KENI_CONSOLA_MFA_ADMIN=0. NO afecta a
# editores. Recuperacion si se pierde el dispositivo: codigos de recuperacion (se muestran al
# registrar la primera llave) o reset de MFA por OTRO admin desde Usuarios.
KENI_CONSOLA_MFA_ADMIN=1
# Relying Party (identidad del servidor ante el autenticador). En LOCAL valen los defectos
# (localhost / http://localhost:8765). En PROD fija el dominio publico:
#   KENI_CONSOLA_RP_ID=social.kenitech.io
#   KENI_CONSOLA_RP_ORIGIN=https://social.kenitech.io   (admite lista separada por comas)
#   KENI_CONSOLA_RP_NOMBRE=Keni Social
# RP_ID = dominio efectivo SIN esquema ni puerto; RP_ORIGIN = origen completo CON esquema/puerto.
KENI_CONSOLA_RP_ID=
KENI_CONSOLA_RP_ORIGIN=
KENI_CONSOLA_RP_NOMBRE=

# ---- Cuenta de Claude para la generacion `claude -p` (la usa el WORKER) ----
# La CUENTA se fija con `claude auth login` desde el panel admin (Sistema -> Cuenta de
# Claude); las credenciales viven en CLAUDE_CONFIG_DIR (/data/claude-cfg), no aqui. Ver
# deploy/README §Cuenta. ANTHROPIC_API_KEY es una alternativa OPCIONAL por API key (facturacion
# por API en vez de suscripcion); vacia por defecto.
ANTHROPIC_API_KEY=

# ---- Postgres (db) ----
# CONSUMIDO por el back (#130): con POSTGRES_USER/PASSWORD/DB puestas, la DB operacional
# (tareas/comercial/rota/usuarios/sesiones) va a Postgres. Sin ellas (perfil local) el back
# usa SQLite. El cutover de datos existentes es one-shot:
#   python -m keni_consola.migracion   (ver deploy/README.md "Cutover a Postgres + S3").
POSTGRES_USER=keni
POSTGRES_PASSWORD=
POSTGRES_DB=keni_social
# MINIMO PRIVILEGIO (CAMINO POR DEFECTO en hosted): la app NO conecta como el superuser
# bootstrap `keni`, sino como el rol `keni_app` (sin superusuario). `APP_DB_PASSWORD` es su
# password; el init script `postgres/initdb/10-app-role.sh` lo crea en el PRIMER arranque
# del cluster (volumen vacio). Pasos:
#   1) APP_DB_PASSWORD=<openssl rand -base64 24>
#   2) DATABASE_URL=postgresql://keni_app:<ESA password literal>@db:5432/keni_social
#      (pon la password LITERAL: compose/back no expanden ${APP_DB_PASSWORD} dentro del DSN
#      al leerla del .env; si lleva caracteres raros, %-encodea).
APP_DB_PASSWORD=
# DATABASE_URL: EN HOSTED es OBLIGATORIO fijarla al rol keni_app (arriba). Si se deja en
# blanco, el back la DERIVA de POSTGRES_* y conectaria como el SUPERUSUARIO `keni`:
# deploy.sh ABORTA el despliegue en ese caso, salvo override expreso de bootstrap/recuperacion
# KENI_PERMITIR_SUPERUSER=1. Tambien sirve para un Postgres externo / DSN con parametros.
DATABASE_URL=
# KENI_PERMITIR_SUPERUSER=1   # SOLO bootstrap/recuperacion: permite desplegar con la app
#                             # conectando como superusuario (deploy.sh avisa en rojo).
# KENI_DEPLOY_SIN_VERIFICAR=1 # SOLO emergencias: salta la verificacion de salud post-up
#                             # y el rollback automatico a :previa de deploy.sh.

# ---- Garage (files / object storage S3) ----
# CONSUMIDO por el back (#130): con S3_ENDPOINT + S3_ACCESS_KEY + S3_SECRET_KEY puestas,
# la media (imagenes) se guarda y se sirve desde el bucket S3/Garage. Sin ellas (perfil
# local) la media va a disco. Las credenciales se generan en el bootstrap de Garage (README).
# GARAGE_RPC_SECRET/GARAGE_ADMIN_TOKEN ya NO viajan como env del contenedor: deploy.sh los
# renderiza a ./secrets/ y Garage los lee via GARAGE_*_FILE (no salen en docker inspect).
GARAGE_RPC_SECRET=        # openssl rand -hex 32
GARAGE_ADMIN_TOKEN=       # openssl rand -base64 24
S3_ENDPOINT=http://files:3900
S3_REGION=garage
S3_BUCKET=keni-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- MCP de metricas ----
# `muestra` = datos offline deterministas (sin credenciales). `real` exige un
# config.toml montado (KENI_METRICAS_CONFIG) con el System User token de Meta.
KENI_METRICAS_FUENTE=muestra
# KENI_METRICAS_CONFIG=/config/config.toml

# ---- Agencias de noticias (item F): Reuters Connect / AFP ----
# CONSUMIDAS por el back: con credencial, la agencia entra al pipeline de fuentes/radar y
# trae notas normalizadas (titulo/resumen/enlace/fecha/fuente) como un feed mas. SIN
# credencial NO rompe nada: la fuente aparece como "pendiente / no configurada" (el Radar y
# la pagina Fuentes lo dicen en claro, sin inventar contenido). Dejalas en BLANCO hasta tener
# la cuenta.
#   Reuters Connect: una API key (Bearer). Opcional KENI_REUTERS_BASE_URL para apuntar a un
#   endpoint/version concreto (def el publico de Reuters Connect).
KENI_REUTERS_API_KEY=
# KENI_REUTERS_BASE_URL=https://api.reutersconnect.com
#   AFP: OAuth2 client_credentials (client_id + client_secret). Opcional KENI_AFP_BASE_URL.
KENI_AFP_CLIENT_ID=
KENI_AFP_CLIENT_SECRET=
# KENI_AFP_BASE_URL=https://afp-apicore-prod.afp.com

# ---- Limites de recursos (hardening, single-VPS) ----
# OPCIONALES. El compose trae defaults CONSERVADORES (ver el bloque de cabecera de
# docker-compose.yml); descomenta y ajusta a la RAM REAL del VPS. La SUMA de los limites
# debe dejar holgura para el host. Sin esto se usan los defaults de abajo.
# Defaults afinados al VPS real (12 vCPU, 61 GiB). Solo descomenta para AJUSTAR.
# DB_MEM_LIMIT=8g          # Postgres: reserva de RAM (corazon del stack).
# BACK_MEM_LIMIT=3g        # gateway Starlette.
# WORKER_MEM_LIMIT=20g     # worker: corre KENI_MAX_JOBS (def 6) `claude -p` EN PARALELO
#                          #   (~2.5 GiB/job en pico + margen). Sube ~3 GiB por job extra.
# WORKER_CPUS=6            # cuota de CPU del worker (6 claude concurrentes ~4–6 nucleos).
# DAEMONS_MEM_LIMIT=2g     # auto-produccion / metricas de fondo.
# MCP_MEM_LIMIT=1g         # keni-metricas HTTP.
# FILES_MEM_LIMIT=3g       # Garage (S3). Subelo si crece la media.
