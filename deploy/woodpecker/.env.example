# Woodpecker CI (deploy/woodpecker/docker-compose.yml). Copia a `.env` y rellena.
# NUNCA commitees el .env real. Misma convencion que el .env del stack principal.

# ---- Host + version ----
# Subdominio del propio server Latitude (162.43.191.103). Requiere registro DNS
# A en Cloudflare en modo DNS-only (gris), porque Traefik valida el cert por
# HTTP-01 (igual que social.kenitech.io).
WOODPECKER_HOSTNAME=ci-social.kenitech.io
WOODPECKER_VERSION=v3.13.0
WOODPECKER_MAX_WORKFLOWS=3

# ---- Admin ----
# Logins de GitHub que entran como admin de Woodpecker (coma-separados).
WOODPECKER_ADMIN=

# ---- GitHub OAuth App (org kenitech-io) ----
# Crear en: https://github.com/organizations/kenitech-io/settings/applications/new
#   Application name:           Woodpecker CI (keni-social)
#   Homepage URL:               https://ci-social.kenitech.io
#   Authorization callback URL: https://ci-social.kenitech.io/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# ---- Secreto compartido server <-> agent ----
# Generar:  openssl rand -hex 32
WOODPECKER_AGENT_SECRET=
